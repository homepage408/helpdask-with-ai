# Application Settings
PROJECT_NAME="HelpDesk Mini"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server Settings (Used by Makefile and Uvicorn)
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Database Settings (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/helpdesk_mini"
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/helpdesk_mini_test"

# Authentication & Security
JWT_SECRET_KEY="change-me-to-a-very-secure-random-secret-key-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
